#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PID_FILE="${CODEX_DESKTOP_WRAPPER_PID_FILE:-$PROJECT_DIR/state/desktop-wrapper-app-server.pid}"

if [[ ! -s "$PID_FILE" ]]; then
  echo "no pid file: $PID_FILE"
  exit 0
fi

pid="$(cat "$PID_FILE")"
if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
  echo "invalid pid file: $PID_FILE" >&2
  exit 1
fi

if kill -0 "$pid" 2>/dev/null; then
  kill "$pid"
  echo "stopped app-server pid $pid"
else
  echo "app-server pid $pid is not running"
fi
