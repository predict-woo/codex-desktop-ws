#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CODEX_APP="${CODEX_DESKTOP_APP:-/Applications/Codex.app}"
CODEX_EXECUTABLE="${CODEX_DESKTOP_EXECUTABLE:-$CODEX_APP/Contents/MacOS/Codex}"
CODEX_CLI_BINARY="${CODEX_DESKTOP_CLI_BINARY:-$CODEX_APP/Contents/Resources/codex}"
NODE_BINARY="${CODEX_DESKTOP_NODE_BINARY:-$CODEX_APP/Contents/Resources/cua_node/bin/node}"
TEMPLATE_PATH="$PROJECT_DIR/templates/Codex WebSocket.applescript.in"
DIST_DIR="$PROJECT_DIR/dist"
APP_PATH="$DIST_DIR/Codex WebSocket.app"
GENERATED_SCRIPT="$DIST_DIR/Codex WebSocket.applescript"
WS_PORT="${CODEX_DESKTOP_WRAPPER_PORT:-45123}"
WS_URL="${CODEX_DESKTOP_WRAPPER_WS_URL:-ws://127.0.0.1:${WS_PORT}}"
DESKTOP_COPY=0
DESKTOP_SYMLINK=0
FORCE=0

usage() {
  cat <<EOF
usage: scripts/install [--desktop-copy] [--desktop-symlink] [--force]

Builds a self-contained launcher app:
  $APP_PATH

Options:
  --desktop-copy      Also copy the built app to ~/Desktop/Codex WebSocket.app.
  --desktop-symlink   Also create ~/Desktop/Codex WebSocket.app as a symlink to the repo app.
                      This is convenient for development but breaks if the clone is removed.
  --force             Replace an existing ~/Desktop/Codex WebSocket.app.

Environment:
  CODEX_DESKTOP_APP           Default: /Applications/Codex.app
  CODEX_DESKTOP_EXECUTABLE    Default: \$CODEX_DESKTOP_APP/Contents/MacOS/Codex
  CODEX_DESKTOP_CLI_BINARY    Default: \$CODEX_DESKTOP_APP/Contents/Resources/codex
  CODEX_DESKTOP_NODE_BINARY   Default: \$CODEX_DESKTOP_APP/Contents/Resources/cua_node/bin/node
  CODEX_DESKTOP_WRAPPER_PORT  Default: 45123
  CODEX_DESKTOP_WRAPPER_WS_URL
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --desktop-copy)
      DESKTOP_COPY=1
      shift
      ;;
    --desktop-symlink)
      DESKTOP_SYMLINK=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$DESKTOP_COPY" -eq 1 && "$DESKTOP_SYMLINK" -eq 1 ]]; then
  echo "--desktop-copy and --desktop-symlink are mutually exclusive" >&2
  exit 2
fi

require_executable() {
  local path="$1"
  local label="$2"
  if [[ ! -x "$path" ]]; then
    echo "missing executable $label: $path" >&2
    exit 1
  fi
}

require_executable "$CODEX_EXECUTABLE" "Codex Desktop app executable"
require_executable "$CODEX_CLI_BINARY" "Codex CLI binary"
require_executable "$NODE_BINARY" "Codex bundled Node.js"
require_executable /usr/bin/osacompile "osacompile"

mkdir -p "$DIST_DIR" "$PROJECT_DIR/state"
chmod +x "$PROJECT_DIR/bin/codex-desktop-appserver-wrapper" "$PROJECT_DIR/bin/codex-stdio-websocket-bridge.mjs"

CODEX_EXECUTABLE="$CODEX_EXECUTABLE" \
CODEX_CLI_BINARY="$CODEX_CLI_BINARY" \
NODE_BINARY="$NODE_BINARY" \
WS_URL="$WS_URL" \
WS_PORT="$WS_PORT" \
/usr/bin/perl -0pe '
  s/__CODEX_EXECUTABLE__/$ENV{CODEX_EXECUTABLE}/g;
  s/__CODEX_CLI_BINARY__/$ENV{CODEX_CLI_BINARY}/g;
  s/__NODE_BINARY__/$ENV{NODE_BINARY}/g;
  s/__WS_URL__/$ENV{WS_URL}/g;
  s/__WS_PORT__/$ENV{WS_PORT}/g;
' "$TEMPLATE_PATH" > "$GENERATED_SCRIPT"

rm -rf "$APP_PATH"
/usr/bin/osacompile -o "$APP_PATH" "$GENERATED_SCRIPT"

APP_RESOURCE_ROOT="$APP_PATH/Contents/Resources/codex-desktop-ws"
rm -rf "$APP_RESOURCE_ROOT"
mkdir -p "$APP_RESOURCE_ROOT/bin"
cp "$PROJECT_DIR/bin/codex-desktop-appserver-wrapper" "$APP_RESOURCE_ROOT/bin/"
cp "$PROJECT_DIR/bin/codex-stdio-websocket-bridge.mjs" "$APP_RESOURCE_ROOT/bin/"
chmod +x "$APP_RESOURCE_ROOT/bin/codex-desktop-appserver-wrapper" "$APP_RESOURCE_ROOT/bin/codex-stdio-websocket-bridge.mjs"

if [[ -f "$CODEX_APP/Contents/Resources/electron.icns" ]]; then
  cp "$CODEX_APP/Contents/Resources/electron.icns" "$APP_PATH/Contents/Resources/electron.icns"
  cp "$CODEX_APP/Contents/Resources/electron.icns" "$APP_PATH/Contents/Resources/applet.icns"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIconFile electron.icns" "$APP_PATH/Contents/Info.plist" >/dev/null
  /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$APP_PATH/Contents/Info.plist" >/dev/null 2>&1 || true
fi

if command -v codesign >/dev/null 2>&1; then
  codesign --force --deep --sign - "$APP_PATH" >/dev/null
fi

xattr -dr com.apple.quarantine "$APP_PATH" 2>/dev/null || true

if [[ "$DESKTOP_COPY" -eq 1 ]]; then
  desktop_app="$HOME/Desktop/Codex WebSocket.app"
  if [[ -L "$desktop_app" ]]; then
    rm "$desktop_app"
  elif [[ -e "$desktop_app" && "$FORCE" -eq 1 ]]; then
    rm -rf "$desktop_app"
  elif [[ -e "$desktop_app" ]]; then
    echo "refusing to replace existing non-symlink: $desktop_app" >&2
    echo "remove it manually, pass --force, or run without --desktop-copy" >&2
    exit 1
  fi
  cp -R "$APP_PATH" "$desktop_app"
  xattr -dr com.apple.quarantine "$desktop_app" 2>/dev/null || true
  echo "copied launcher to Desktop: $desktop_app"
fi

if [[ "$DESKTOP_SYMLINK" -eq 1 ]]; then
  desktop_link="$HOME/Desktop/Codex WebSocket.app"
  if [[ -L "$desktop_link" ]]; then
    rm "$desktop_link"
  elif [[ -e "$desktop_link" && "$FORCE" -eq 1 ]]; then
    rm -rf "$desktop_link"
  elif [[ -e "$desktop_link" ]]; then
    echo "refusing to replace existing non-symlink: $desktop_link" >&2
    echo "remove it manually, pass --force, or run without --desktop-symlink" >&2
    exit 1
  fi
  ln -s "$APP_PATH" "$desktop_link"
  echo "created Desktop symlink: $desktop_link -> $APP_PATH"
fi

echo "built launcher: $APP_PATH"
echo "websocket URL: $WS_URL"
echo "runtime state: ~/Library/Application Support/Codex Desktop WebSocket"
